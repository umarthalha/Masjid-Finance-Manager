rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Catch-all default deny to enforce zero-trust security
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection Rules ---
    match /users/{userId} {
      allow get: if isSignedIn();
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && incoming().name is string && incoming().name.size() <= 100
        && incoming().email is string && incoming().email.size() <= 150
        && (incoming().phone == null || (incoming().phone is string && incoming().phone.size() <= 30))
        && (incoming().activeMasjidId == null || (incoming().activeMasjidId is string && incoming().activeMasjidId.size() <= 128));
    }

    // --- Masjids Collection Rules ---
    match /masjids/{masjidId} {
      allow read: if isSignedIn(); // Public lookup of masjids for signed-in users
      allow create: if isSignedIn()
        && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 120
        && incoming().area is string && incoming().area.size() >= 2 && incoming().area.size() <= 120
        && incoming().createdBy == request.auth.uid
        && incoming().createdAt == request.time
        && (incoming().clearPassword == null || (incoming().clearPassword is string && incoming().clearPassword.size() <= 100));
      allow update: if isSignedIn()
        && existing().createdBy == request.auth.uid
        && incoming().createdBy == existing().createdBy
        && incoming().createdAt == existing().createdAt
        && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 120
        && incoming().area is string && incoming().area.size() >= 2 && incoming().area.size() <= 120
        && (incoming().clearPassword == null || (incoming().clearPassword is string && incoming().clearPassword.size() <= 100));
    }

    // --- Finance Entries Collection Rules ---
    match /entries/{entryId} {
      allow read: if isSignedIn(); // Users can view entries of selected masjids
      
      allow create: if isSignedIn()
        && incoming().userId == request.auth.uid
        && incoming().masjidId is string && incoming().masjidId.size() <= 128
        && incoming().amount is number && incoming().amount > 0
        && incoming().type in ['income', 'expense']
        && incoming().category is string && incoming().category.size() <= 100
        && incoming().date is string && incoming().date.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && incoming().createdAt == request.time
        && incoming().month is string && incoming().month.size() <= 15
        && incoming().year is string && incoming().year.size() <= 10
        && incoming().quarter is string && incoming().quarter.size() <= 15
        && (incoming().description == null || (incoming().description is string && incoming().description.size() <= 1000));

      allow update, delete: if isSignedIn()
        && (existing().userId == request.auth.uid || get(/databases/$(database)/documents/masjids/$(existing().masjidId)).data.createdBy == request.auth.uid);
    }

    // --- Temporary Categories Collection Rules ---
    match /temp_categories/{categoryId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && incoming().name is string && incoming().name.size() >= 1 && incoming().name.size() <= 100
        && incoming().type in ['income', 'expense']
        && incoming().month is string && incoming().month.size() <= 15
        && incoming().masjidId is string && incoming().masjidId.size() <= 128
        && incoming().createdAt == request.time;
      allow delete: if isSignedIn();
    }
  }
}
